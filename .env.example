# Neon PostgreSQL connection string (pooled, for app runtime).
# Get this from the Neon console: Project → Connect → Pooled connection.
DATABASE_URL="postgresql://user:password@ep-example-000000.region.aws.neon.tech/almalyani?sslmode=require"

# Shared password that unlocks /private. Pick your own value — never commit
# the real one.
SITE_PASSWORD="change-me"

# Random secret used to sign the private-area session cookie. Generate with:
# openssl rand -hex 32
SESSION_SECRET="change-me-too"
